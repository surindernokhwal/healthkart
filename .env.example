# Copy this file to .env and fill in the values. Never commit .env.

# Neon PostgreSQL (neon.tech -> your project -> Connect)
# Pooled connection (host contains "-pooler"), used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same URL without "-pooler"), used by migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret: generate with  npx auth secret  (or any 32+ random characters)
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Gmail SMTP for email notifications (optional: emails are logged to the console if empty).
# Use a Gmail "App password" (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_USER=""
SMTP_PASS=""

# Clinic details shown on pages, prescriptions and invoices
CLINIC_NAME="City Care Clinic"
CLINIC_ADDRESS="Rajpur Road, Dehradun, Uttarakhand 248001"
CLINIC_PHONE="+91 135 000 0000"
CLINIC_EMAIL=""
CLINIC_HOURS="Mon–Sat: 9:30 AM – 7:00 PM · Sunday closed"
